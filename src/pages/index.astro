---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Welcome to Tech Lounge</h1>
			<p>
				This is the home page. New posts you publish through the <a href="/admin/">editor</a>
				show up automatically on the <a href="/blog/">blog page</a>.
			</p>
			<p>
				You can rewrite this welcome text directly in <code>src/pages/index.astro</code>.
			</p>
		</main>
		<Footer />
	</body>
</html>
